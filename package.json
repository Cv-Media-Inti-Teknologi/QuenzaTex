{
  "name": "quenzatex",
  "version": "0.1.334",
  "description": "AI-Powered LaTeX Editor",
  "author": {
    "name": "CV Media Inti Teknologi",
    "email": "admin@gomit.id"
  },
  "homepage": "https://github.com/Cv-Media-Inti-Teknologi/QuenzaTex",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "cross-env QUENZATEX_MODE=development electron-vite dev",
    "build": "cross-env QUENZATEX_MODE=production electron-vite build",
    "build:dev": "cross-env QUENZATEX_MODE=development electron-vite build",
    "preview": "cross-env QUENZATEX_MODE=production electron-vite preview",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "release": "npm run build && electron-builder --config electron-builder.yml --publish always",
    "package:dev": "npm run build:dev && electron-builder --config electron-builder.dev.yml --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
